@model List<SarEquipEnterprise.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2">User Management</h1>
                <div>
                    <a asp-action="CreateUser" class="btn btn-success me-2">
                        <i class="fas fa-user-plus"></i> Create User
                    </a>
                    <a asp-action="Dashboard" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold">All Users (@Model.Count)</h6>
            <button type="button" class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#refreshModal">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>

        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th style="width: 30%;">Email</th>
                                <th style="width: 20%;">Name</th>
                                <th style="width: 15%;">Role</th>
                                <th style="width: 15%;">Status</th>
                                <th style="width: 20%;">Joined</th>
                                <th style="width: 15%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr class="@(!user.IsActive ? "table-light" : "")">
                                    <td>
                                        <strong>@user.Email</strong>
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(user.FullName) ? "-" : user.FullName)
                                    </td>
                                    <td>
                                        <span class="badge bg-@RoleColor(user.Role)">
                                            @user.Role
                                        </span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check-circle"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fas fa-times-circle"></i> Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@user.CreatedDate.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <a asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-sm btn-link text-primary p-1 me-2" title="View/Edit">
                                                <span style="font-size: 1.2rem;">👁</span>
                                            </a>
                                            
                                            @if (user.Role != SarEquipEnterprise.Models.UserRole.SuperAdmin || Model.Count(u => u.Role == SarEquipEnterprise.Models.UserRole.SuperAdmin) > 1)
                                            {
                                                <button type="button" class="btn btn-sm btn-link text-danger p-1 me-2 archive-user" data-user-id="@user.UserId" data-user-email="@user.Email" title="Archive">
                                                    <span style="font-size: 1.2rem;">🗑️</span>
                                                </button>
                                            }

                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-light border p-1" type="button" id="dropdownMenuButton@user.UserId" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="fas fa-ellipsis-v"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end p-2 shadow" aria-labelledby="dropdownMenuButton@user.UserId">
                                                    <li>
                                                        <button type="button" class="dropdown-item rounded-pill btn btn-sm btn-outline-@(user.IsActive ? "danger" : "success") toggle-status text-center" data-user-id="@user.UserId" data-is-active="@user.IsActive">
                                                            <i class="fas fa-@(user.IsActive ? "user-slash" : "user-check") me-1"></i>
                                                            @(user.IsActive ? "Deactivate" : "Activate")
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">
                    <i class="fas fa-users fa-3x mb-3 text-secondary"></i><br>
                    <p>No users found.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Archive Confirmation Modal -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-labelledby="archiveModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="archiveModalLabel">Archive User</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to archive user <strong id="archiveUserEmail"></strong>?</p>
                <p class="text-danger"><small><i class="fas fa-info-circle"></i> The user will be deactivated and removed from this list, but their data will be kept.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmArchiveBtn">Archive User</button>
            </div>
        </div>
    </div>
</div>

<script>
    let archiveUserId = null;

    // Archive button handler
    document.querySelectorAll('.archive-user').forEach(btn => {
        btn.addEventListener('click', function() {
            archiveUserId = this.getAttribute('data-user-id');
            const userEmail = this.getAttribute('data-user-email');
            document.getElementById('archiveUserEmail').textContent = userEmail;
            new bootstrap.Modal(document.getElementById('archiveModal')).show();
        });
    });

    // Confirm archive
    document.getElementById('confirmArchiveBtn').addEventListener('click', async function() {
        const response = await fetch(`/Admin/ArchiveUser/${archiveUserId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        });

        const result = await response.json();
        
        if (result.success) {
            location.reload();
        } else {
            alert('Error: ' + result.message);
        }
    });

    // Toggle status handler
    document.querySelectorAll('.toggle-status').forEach(btn => {
        btn.addEventListener('click', async function() {
            const userId = this.getAttribute('data-user-id');
            const response = await fetch(`/Admin/DeactivateUser/${userId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                }
            });

            const result = await response.json();
            
            if (result.success) {
                location.reload();
            } else {
                alert('Error: ' + result.message);
            }
        });
    });
</script>

@functions {
    string RoleColor(SarEquipEnterprise.Models.UserRole role)
    {
        return role switch
        {
            SarEquipEnterprise.Models.UserRole.SuperAdmin => "danger",
            SarEquipEnterprise.Models.UserRole.Admin => "warning",
            SarEquipEnterprise.Models.UserRole.Employee => "info",
            _ => "secondary"
        };
    }
}
