@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h2">Administration Panel</h1>
                <span class="badge bg-danger">Super Admin Only</span>
            </div>
        </div>
    </div>

    <!-- Key Metrics -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-primary text-uppercase mb-1" style="font-size: 0.85rem; font-weight: bold;">Total Users</div>
                    <div class="h4 mb-0 font-weight-bold">@ViewBag.TotalUsers</div>
                    <small class="text-muted d-block mt-2">All registered users</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-success text-uppercase mb-1" style="font-size: 0.85rem; font-weight: bold;">Active Users</div>
                    <div class="h4 mb-0 font-weight-bold">@ViewBag.ActiveUsers</div>
                    <small class="text-muted d-block mt-2">Currently active</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-danger text-uppercase mb-1" style="font-size: 0.85rem; font-weight: bold;">Administrators</div>
                    <div class="h4 mb-0 font-weight-bold">@ViewBag.Admins</div>
                    <small class="text-muted d-block mt-2">Admin accounts</small>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="text-warning text-uppercase mb-1" style="font-size: 0.85rem; font-weight: bold;">Employees</div>
                    <div class="h4 mb-0 font-weight-bold">@ViewBag.Employees</div>
                    <small class="text-muted d-block mt-2">Employee accounts</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 font-weight-bold">System Management</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a asp-action="Users" class="btn btn-primary w-100 h-100 d-flex flex-column justify-content-center align-items-center shadow-sm" style="min-height: 140px; border-radius: 0.5rem;">
                                <i class="fas fa-users fa-2x mb-2"></i>
                                <span class="h5 mb-1 font-weight-bold">Manage Users</span>
                                <small>Edit roles & permissions</small>
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Reports" asp-action="Index" class="btn btn-info w-100 h-100 d-flex flex-column justify-content-center align-items-center shadow-sm" style="min-height: 140px; border-radius: 0.5rem;">
                                <i class="fas fa-chart-line fa-2x mb-2"></i>
                                <span class="h5 mb-1 font-weight-bold">View Reports</span>
                                <small>System analytics</small>
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Integration" asp-action="Index" class="btn btn-secondary w-100 h-100 d-flex flex-column justify-content-center align-items-center shadow-sm" style="min-height: 140px; border-radius: 0.5rem;">
                                <i class="fas fa-cogs fa-2x mb-2"></i>
                                <span class="h5 mb-1 font-weight-bold">Settings</span>
                                <small>System configuration</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- System Info -->
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white py-3">
                    <h6 class="m-0 font-weight-bold">Role Distribution</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Super Admins</span>
                            <span class="font-weight-bold">@ViewBag.SuperAdmins</span>
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @(ViewBag.TotalUsers > 0 ? ((ViewBag.SuperAdmins * 100) / ViewBag.TotalUsers).ToString("F0") : "0")%;" aria-valuenow="@ViewBag.SuperAdmins" aria-valuemin="0" aria-valuemax="@ViewBag.TotalUsers"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Administrators</span>
                            <span class="font-weight-bold">@ViewBag.Admins</span>
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @(ViewBag.TotalUsers > 0 ? ((ViewBag.Admins * 100) / ViewBag.TotalUsers).ToString("F0") : "0")%;" aria-valuenow="@ViewBag.Admins" aria-valuemin="0" aria-valuemax="@ViewBag.TotalUsers"></div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Employees</span>
                            <span class="font-weight-bold">@ViewBag.Employees</span>
                        </div>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @(ViewBag.TotalUsers > 0 ? ((ViewBag.Employees * 100) / ViewBag.TotalUsers).ToString("F0") : "0")%;" aria-valuenow="@ViewBag.Employees" aria-valuemin="0" aria-valuemax="@ViewBag.TotalUsers"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header bg-success text-white py-3">
                    <h6 class="m-0 font-weight-bold">Security Status</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h5 class="mb-3">Account Status</h5>
                        <div class="row text-center">
                            <div class="col-6 mb-3">
                                <div class="display-4 text-success">@ViewBag.ActiveUsers</div>
                                <small class="text-secondary">Active</small>
                            </div>
                            <div class="col-6 mb-3">
                                <div class="display-4 text-warning">@(ViewBag.TotalUsers - ViewBag.ActiveUsers)</div>
                                <small class="text-secondary">Inactive</small>
                            </div>
                        </div>
                    </div>
                    <hr>
                    <p class="text-muted small mb-0">
                        <i class="fas fa-info-circle"></i>
                        Monitor user activity and manage account status from the Users management page.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 0.25rem solid #4e73df !important;
    }
    .border-left-success {
        border-left: 0.25rem solid #1cc88a !important;
    }
    .border-left-danger {
        border-left: 0.25rem solid #e74c3c !important;
    }
    .border-left-warning {
        border-left: 0.25rem solid #f6c23e !important;
    }
</style>
