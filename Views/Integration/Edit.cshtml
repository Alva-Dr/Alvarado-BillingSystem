@model SarEquipEnterprise.Models.AccountingIntegration

@{
    ViewData["Title"] = "Edit Integration";
}

<div class="container">
    <h1>Edit Integration</h1>
    <hr />

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="IntegrationId" />

        <div class="row">
            <div class="col-md-6">
                <div class="card mb-3">
                    <div class="card-header">Integration Details</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="IntegrationType" class="form-label"></label>
                            <select asp-for="IntegrationType" class="form-select">
                                <option value="">-- Select Type --</option>
                                <option value="QuickBooks">QuickBooks</option>
                                <option value="Xero">Xero</option>
                                <option value="Sage">Sage</option>
                                <option value="Custom API">Custom API</option>
                            </select>
                            <span asp-validation-for="IntegrationType" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ApiEndpoint" class="form-label"></label>
                            <input asp-for="ApiEndpoint" class="form-control" />
                            <span asp-validation-for="ApiEndpoint" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ApiKey" class="form-label"></label>
                            <input asp-for="ApiKey" type="password" class="form-control" placeholder="Leave blank to keep current" />
                            <span asp-validation-for="ApiKey" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">
                                    Active
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            <input type="submit" value="Save Changes" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
