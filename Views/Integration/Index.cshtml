@model List<SarEquipEnterprise.Models.AccountingIntegration>

@{
    ViewData["Title"] = "Accounting Integrations";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Accounting Integrations</h1>
        <a asp-action="Create" class="btn btn-primary">Add Integration</a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Integration Type</th>
                                <th>API Endpoint</th>
                                <th>Status</th>
                                <th>Last Sync</th>
                                <th>Sync Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var integration in Model)
                            {
                                <tr>
                                    <td>@integration.IntegrationType</td>
                                    <td>@integration.ApiEndpoint</td>
                                    <td>
                                        <span class="badge bg-@(integration.IsActive ? "success" : "secondary")">
                                            @(integration.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@(integration.LastSyncDate == DateTime.MinValue ? "Never" : integration.LastSyncDate.ToString("MM/dd/yyyy HH:mm"))</td>
                                    <td>
                                        <span class="badge bg-@(integration.SyncStatus == "Success" ? "success" : integration.SyncStatus == "Failed" ? "danger" : "warning")">
                                            @integration.SyncStatus
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@integration.IntegrationId" class="text-info fs-5 me-2" title="View"><i class="fas fa-eye"></i></a>
                                        <a asp-action="Edit" asp-route-id="@integration.IntegrationId" class="text-warning fs-5 me-2" title="Edit"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="bg-transparent border-0 text-success p-0 fs-5 test-connection" data-id="@integration.IntegrationId" title="Test Connection"><i class="fas fa-plug"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <p>No integrations configured. <a asp-action="Create">Add your first integration</a> to get started.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.test-connection').forEach(btn => {
            btn.addEventListener('click', async function() {
                const id = this.getAttribute('data-id');
                const response = await fetch(`/Integration/TestConnection?id=${id}`, {
                    method: 'POST'
                });
                const result = await response.json();
                alert(result.success ? 'Connection successful!' : 'Connection failed!');
            });
        });
    </script>
}
