@model SarEquipEnterprise.Models.Payment

@{
    ViewData["Title"] = "Process Refund";
}

<div class="container">
    <h1>Process Refund</h1>
    <hr />

    <div class="alert alert-warning">
        <strong>Warning:</strong> This action will refund the payment. Are you sure you want to continue?
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5>Payment Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Payment Number:</dt>
                <dd class="col-sm-9">@Model.PaymentNumber</dd>

                <dt class="col-sm-3">Amount:</dt>
                <dd class="col-sm-9">₱@Model.Amount.ToString("N2")</dd>

                <dt class="col-sm-3">Payment Date:</dt>
                <dd class="col-sm-9">@Model.PaymentDate.ToString("MM/dd/yyyy")</dd>

                <dt class="col-sm-3">Payment Method:</dt>
                <dd class="col-sm-9">@Model.PaymentMethod</dd>
            </dl>
        </div>
    </div>

    <form asp-action="Refund" method="post">
        <input type="hidden" asp-for="PaymentId" />
        <div class="mb-3">
            <label for="refundAmount" class="form-label">Refund Amount</label>
            <input type="number" step="0.01" name="refundAmount" class="form-control" value="@Model.Amount" max="@Model.Amount" />
            <small class="form-text text-muted">Maximum refund amount: ₱@Model.Amount.ToString("N2")</small>
        </div>
        <div class="form-group">
            <input type="submit" value="Process Refund" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
