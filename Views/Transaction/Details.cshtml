@model SarEquipEnterprise.Models.Transaction

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Transaction Details</h1>
        <div>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5>Transaction Information</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Transaction Number:</dt>
                <dd class="col-sm-9">@Model.TransactionNumber</dd>

                <dt class="col-sm-3">Transaction Date:</dt>
                <dd class="col-sm-9">@Model.TransactionDate.ToString("MM/dd/yyyy")</dd>

                <dt class="col-sm-3">Type:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-@(Model.TransactionType == "Credit" ? "success" : "danger")">
                        @Model.TransactionType
                    </span>
                </dd>

                <dt class="col-sm-3">Category:</dt>
                <dd class="col-sm-9">@Model.Category</dd>

                <dt class="col-sm-3">Amount:</dt>
                <dd class="col-sm-9" class="@(Model.TransactionType == "Credit" ? "text-success" : "text-danger")">
                    @(Model.TransactionType == "Credit" ? "+" : "-")₱@Model.Amount.ToString("N2")
                </dd>

                <dt class="col-sm-3">Balance After:</dt>
                <dd class="col-sm-9">₱@Model.BalanceAfter.ToString("N2")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-@(Model.Status == "Completed" ? "success" : "warning")">
                        @Model.Status
                    </span>
                </dd>

                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                @if (!string.IsNullOrEmpty(Model.Reference))
                {
                    <dt class="col-sm-3">Reference:</dt>
                    <dd class="col-sm-9">@Model.Reference</dd>
                }

                @if (Model.InvoiceId.HasValue)
                {
                    <dt class="col-sm-3">Invoice ID:</dt>
                    <dd class="col-sm-9">@Model.InvoiceId</dd>
                }

                @if (Model.PaymentId.HasValue)
                {
                    <dt class="col-sm-3">Payment ID:</dt>
                    <dd class="col-sm-9">@Model.PaymentId</dd>
                }
            </dl>
        </div>
    </div>
</div>
