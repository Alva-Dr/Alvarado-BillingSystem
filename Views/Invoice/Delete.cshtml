@model SarEquipEnterprise.Models.Invoice

@{
    ViewData["Title"] = "Delete Invoice";
}

<div class="container">
    <h1>Delete Invoice</h1>
    <h3>Are you sure you want to delete this invoice?</h3>
    <hr />

    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Invoice Number:</dt>
                <dd class="col-sm-9">@Model.InvoiceNumber</dd>

                <dt class="col-sm-3">Customer Name:</dt>
                <dd class="col-sm-9">@Model.CustomerName</dd>

                <dt class="col-sm-3">Invoice Date:</dt>
                <dd class="col-sm-9">@Model.InvoiceDate.ToString("MM/dd/yyyy")</dd>

                <dt class="col-sm-3">Total Amount:</dt>
                <dd class="col-sm-9">₱@Model.TotalAmount.ToString("N2")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-@(Model.Status == "Paid" ? "success" : Model.Status == "Overdue" ? "danger" : "warning")">
                        @Model.Status
                    </span>
                </dd>
            </dl>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="InvoiceId" />
                <div class="form-group">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
