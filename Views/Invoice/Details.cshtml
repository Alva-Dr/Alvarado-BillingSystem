@model SarEquipEnterprise.Models.Invoice

@{
    ViewData["Title"] = "Invoice Details";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Invoice Details</h1>
        <div>
            <a asp-action="GeneratePdf" asp-route-id="@Model.InvoiceId" class="btn btn-primary"><i class="fas fa-file-pdf"></i> Download PDF</a>
            <a asp-action="Edit" asp-route-id="@Model.InvoiceId" class="btn btn-warning"><i class="fas fa-edit"></i> Edit</a>
            <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Back to List</a>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5>Invoice Information</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Invoice Number:</dt>
                        <dd class="col-sm-8">@Model.InvoiceNumber</dd>

                        <dt class="col-sm-4">Invoice Date:</dt>
                        <dd class="col-sm-8">@Model.InvoiceDate.ToString("MM/dd/yyyy")</dd>

                        <dt class="col-sm-4">Due Date:</dt>
                        <dd class="col-sm-8">@Model.DueDate.ToString("MM/dd/yyyy")</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(Model.Status == "Paid" ? "success" : Model.Status == "Overdue" ? "danger" : Model.Status == "Sent" ? "info" : "secondary")">
                                @Model.Status
                            </span>
                        </dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">Customer Name:</dt>
                        <dd class="col-sm-8">@Model.CustomerName</dd>

                        <dt class="col-sm-4">Customer Email:</dt>
                        <dd class="col-sm-8">@Model.CustomerEmail</dd>

                        <dt class="col-sm-4">Customer Address:</dt>
                        <dd class="col-sm-8">@Model.CustomerAddress</dd>

                        <dt class="col-sm-4">Payment Terms:</dt>
                        <dd class="col-sm-8">@Model.PaymentTerms</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5>Invoice Items</h5>
        </div>
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.Description</td>
                                <td>@item.Quantity</td>
                                <td>₱@item.UnitPrice.ToString("N2")</td>
                                <td>₱@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">No items added to this invoice.</p>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6"></div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-6">Subtotal:</dt>
                        <dd class="col-sm-6">₱@Model.SubTotal.ToString("N2")</dd>

                        <dt class="col-sm-6">Tax Amount:</dt>
                        <dd class="col-sm-6">₱@Model.TaxAmount.ToString("N2")</dd>

                        <dt class="col-sm-6">Discount:</dt>
                        <dd class="col-sm-6">₱@Model.DiscountAmount.ToString("N2")</dd>

                        <dt class="col-sm-6"><strong>Total Amount:</strong></dt>
                        <dd class="col-sm-6"><strong>₱@Model.TotalAmount.ToString("N2")</strong></dd>
                    </dl>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="mt-3">
                    <strong>Notes:</strong>
                    <p>@Model.Notes</p>
                </div>
            }
        </div>
    </div>

    @if (Model.Status == "Draft" || Model.Status == "Sent")
    {
        <div class="mt-4 d-flex gap-2">
            <form asp-action="Send" asp-route-id="@Model.InvoiceId" method="post">
                <button type="submit" class="btn btn-success">Send Invoice</button>
            </form>
            <form asp-controller="Payment" asp-action="PayWithPayMongo" asp-route-invoiceId="@Model.InvoiceId" method="post">
                <button type="submit" class="btn" style="background-color: #0b9b3e; color: white; border-color: #0b9b3e;">
                    <i class="fas fa-credit-card"></i> Pay with PayMongo
                </button>
            </form>
        </div>
    }
</div>
